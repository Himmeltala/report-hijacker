{
  "name": "task-manager",
  "productName": "TaskManager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@11.20.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "preinstall": "node scripts/check-pnpm.cjs",
    "postinstall": "node scripts/install-electron.js",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json && node scripts/clean-dist-electron.js && vite build",
    "preview": "vite preview",
    "update:server": "node server/update-server.mjs",
    "make:win": "node scripts/make-win.js",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"schedules/**/*.ts\" \"electron/**/*.ts\" \"*.ts\"",
    "lint": "eslint src/ schedules/ --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src/ schedules/ --fix --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.2",
    "exceljs": "^4.4.0",
    "lodash-es": "^4.18.1",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "moment": "^2.30.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.3",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-local": "file:.eslint-plugin-local",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.9.3",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.0",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue-tsc": "^3.3.5"
  }
}

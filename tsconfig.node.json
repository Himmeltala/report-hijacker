{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@electron/*": ["./electron/*"],
      "@schedules/*": ["./schedules/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "electron/**/*.ts",
    "schedules/main/**/*.ts",
    "electron-builder.yml",
    "package.json"
  ]
}

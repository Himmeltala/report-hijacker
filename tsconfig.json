{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // 只自动加载 node 的类型。electron-builder 的依赖树会带进 @types/minimatch 这类空壳包，
    // 默认行为是把 node_modules/@types 下所有包都当隐式类型库加载，遇到空壳就报 TS2688
    "types": ["node"],
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@electron/*": ["./electron/*"],
      "@schedules/*": ["./schedules/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "schedules/renderer/**/*.ts"]
}
